<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CHANGE THIS from netstandard2.0 -->
    <TargetFramework>net35</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="assembly_export\**\*.cs" />
    <EmbeddedResource Remove="assembly_export\**\*" />
    <None Include="assembly_export\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Overcooked\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony (for patching, optional but very useful) -->
    <Reference Include="0Harmony">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Overcooked\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity assemblies -->
    <Reference Include="UnityEngine">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Overcooked\Overcooked_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assembly (where Player / Item etc live) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Overcooked\Overcooked_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Optional: copy to BepInEx/plugins on build -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy
      SourceFiles="$(TargetDir)$(TargetFileName)"
      DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Overcooked\BepInEx\plugins"
      OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
